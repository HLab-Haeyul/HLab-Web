FROM oven/bun:1 AS build

WORKDIR /app

ARG VITE_BLOG_API_ENABLED=false
ARG VITE_PORTFOLIO_METRICS_API_ENABLED=false
ARG VITE_ADMIN_ENABLED=false
ARG VITE_AUTH_API_URL=
ARG VITE_AUTH_API_BASE_URL=
ARG VITE_AUTH_API_PATH=

ENV VITE_BLOG_API_ENABLED=${VITE_BLOG_API_ENABLED}
ENV VITE_PORTFOLIO_METRICS_API_ENABLED=${VITE_PORTFOLIO_METRICS_API_ENABLED}
ENV VITE_ADMIN_ENABLED=${VITE_ADMIN_ENABLED}
ENV VITE_AUTH_API_URL=${VITE_AUTH_API_URL}
ENV VITE_AUTH_API_BASE_URL=${VITE_AUTH_API_BASE_URL}
ENV VITE_AUTH_API_PATH=${VITE_AUTH_API_PATH}

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build-only

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
